{
  "name": "quiz-workspace",
  "version": "0.0.0",
  "private": true,
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.15.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "lint": "nx run-many -t lint",
    "lint-typecheck": "nx run-many -t lint-typecheck",
    "lint-eslint": "nx run-many -t lint-eslint",
    "lint-prettier": "nx run-many -t lint-prettier",
    "lint-knip": "nx run-many -t lint-knip",
    "start": "nx run @platform/cli:start"
  },
  "devDependencies": {
    "nx": "23.3.0"
  }
}
